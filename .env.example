# Copy to .env and fill in real values. Never commit .env.
#
# Values below marked "REQUIRED IN PRODUCTION" are validated at startup by
# apps.core.checks (see backend/apps/core/checks.py) whenever
# ENVIRONMENT=production — `manage.py check` and `manage.py migrate` both
# fail fast, before touching the database, if any are missing or unsafe.
# Development and test never require these — see ENVIRONMENT below.

# ============================================================================
# Shared
# ============================================================================

# development | test | production — explicit, not inferred from DEBUG or the
# settings module filename. Each config/settings/*.py module already sets
# its own literal value (development.py -> "development", test.py -> "test",
# production.py -> "production"); this only matters if you introduce a new
# settings module and forget to set it there — the safe fallback is
# "development", never "production".
ENVIRONMENT=development

# Which settings module to boot. Local/dev containers normally use
# config.settings.development; CI uses config.settings.test; production
# deployments must use config.settings.production.
DJANGO_SETTINGS_MODULE=config.settings.development
# DJANGO_SETTINGS_MODULE=config.settings.production   # production example

# REQUIRED IN PRODUCTION. A unique, unpredictable value — not the placeholder
# below, not short, not committed anywhere. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret

# Must be "false" in production (production.py hardcodes DEBUG=False
# regardless of this value, but keep it false here too — DEBUG=True leaks
# stack traces, settings, and environment details on error pages).
DJANGO_DEBUG=true

# REQUIRED IN PRODUCTION. Comma-separated exact hostnames this instance is
# served from, e.g. "app.example.com". A bare wildcard ("*") is rejected by
# the production checks — Django's Host-header validation exists precisely
# to prevent host-header-based attacks, and a wildcard defeats it. Under
# docker-compose.prod.yml specifically, two internal names must always be
# included alongside the public domain, or the container never reports
# healthy/reachable even though the app itself is fine:
#   - "backend" (the internal Compose service name) — the frontend's
#     Next.js rewrite proxy forwards requests with Host: backend:8000, not
#     the public-facing hostname, and Django would otherwise reject every
#     proxied /api/* request with 400 Bad Request.
#   - "localhost" — docker-compose.prod.yml's own backend healthcheck runs
#     inside the container as `curl`-equivalent to
#     http://localhost:8000/api/health/ready/, so without "localhost" here
#     the healthcheck itself gets a 400 DisallowedHost response and the
#     container is reported unhealthy (backend never starts serving,
#     frontend never comes up either — depends_on: condition:
#     service_healthy) even though `manage.py check` passed and gunicorn is
#     genuinely running.
#
# Production example (only include www.quorfix.com if that subdomain is
# actually intended to serve traffic — otherwise a browser landing there
# gets Django's Host-header rejection instead of a working page; redirecting
# www -> apex, or the reverse, is a reverse-proxy/DNS responsibility, not
# something this application does — see docs/INSTALLATION.md):
#   DJANGO_ALLOWED_HOSTS=quorfix.com,www.quorfix.com,backend,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ============================================================================
# Database (PostgreSQL)
# ============================================================================

# REQUIRED IN PRODUCTION: NAME and HOST must be non-empty, and the stack only
# supports PostgreSQL (SQLite is rejected by the production checks).
POSTGRES_DB=quorfix
POSTGRES_USER=quorfix
POSTGRES_PASSWORD=quorfix
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================================================
# Redis / Celery
# ============================================================================

# REQUIRED IN PRODUCTION. Backs the shared cache (throttle counters, the
# analytics dashboard cache) and the Celery broker — must be a real
# redis:// or rediss:// URL, not a placeholder or unreachable host. The
# production checks validate the URL scheme only; they never attempt a
# network connection (that belongs to the readiness endpoint, not a
# system check).
REDIS_URL=redis://redis:6379/0

# ============================================================================
# CORS / CSRF (frontend origins)
# ============================================================================

# Same-origin note: the default architecture serves the Next.js frontend and
# proxies /api/* through it to the backend (see frontend/next.config.ts), so
# the browser only ever talks to one origin. In that shape,
# CORS_ALLOWED_ORIGINS should be left EMPTY in production — the production
# checks accept that as valid and do not require it to be non-empty. Only
# set it if something other than the bundled frontend needs direct
# cross-origin browser access to the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# REQUIRED IN PRODUCTION. Comma-separated origins the browser will POST/PUT/
# PATCH/DELETE from — must include an explicit http:// or https:// scheme
# (HTTPS is strongly recommended in production). A bare wildcard ("*") is
# rejected; a scoped subdomain wildcard like "https://*.example.com" is
# accepted, matching what Django itself supports.
#
# Production example (same www caveat as DJANGO_ALLOWED_HOSTS above):
#   CSRF_TRUSTED_ORIGINS=https://quorfix.com,https://www.quorfix.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ============================================================================
# Cookies / security
# ============================================================================
#
# No environment variables here — session/CSRF cookie flags (Secure,
# HttpOnly, SameSite) and the HTTPS-redirect/HSTS settings are hardcoded per
# settings module (see backend/config/settings/base.py and production.py),
# not read from the environment, so they can never be silently weakened by a
# stray .env value. Production hardcodes SESSION_COOKIE_SECURE=True,
# CSRF_COOKIE_SECURE=True, SESSION_COOKIE_HTTPONLY=True,
# SESSION_COOKIE_SAMESITE="Lax" (chosen so an already-signed-in user
# following an emailed invitation link — a cross-site top-level navigation —
# still carries their session cookie; "Strict" would block that),
# SECURE_SSL_REDIRECT=True, and SECURE_PROXY_SSL_HEADER assuming TLS
# terminates at an upstream reverse proxy that forwards
# X-Forwarded-Proto. All of this is verified at startup by the production
# checks (quorfix.E007, quorfix.E008).

# ============================================================================
# Frontend
# ============================================================================

# BACKEND_INTERNAL_URL is container-to-container only (Next.js's server-side
# rewrite proxy -> the backend service, see docker-compose.prod.yml) and
# never changes for a same-origin deployment — it does not become
# api.quorfix.com or similar; the browser only ever talks to the frontend
# origin, which forwards /api/* internally. FRONTEND_BASE_URL is the
# public origin used to build links in outgoing email (invitations,
# notifications) and CORS/session context.
#
# Production example:
#   FRONTEND_BASE_URL=https://quorfix.com
#   (BACKEND_INTERNAL_URL stays http://backend:8000 — internal Docker
#   network traffic, never the public domain.)
BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_BASE_URL=http://localhost:3000

# Optional site-wide notice shown above every page (public and
# authenticated) — e.g. for a shared demo/community-beta deployment where
# visitors should know not to enter confidential information and that data
# may be reset. Leave blank for a normal/private installation; nothing is
# shown. Plain text only — never rendered as HTML.
DEMO_BANNER_MESSAGE=

# Demo-only "Quick Access" role login (Explore by Role) — lets a public demo
# visitor sign in as one of five fixed Community personas (administrator,
# developer, qa, reporter, viewer) by role only, never by password. MUST be
# false (the default) for an ordinary Community installation, including
# local development — leave this unset unless you are standing up a
# dedicated, disposable public demo deployment (e.g. demo.quorfix.com; see
# docs/DEMO_DEPLOYMENT.md). Requires the "Quorfix Demo" organization
# (slug quorfix-demo) to already exist — run `manage.py seed_demo`
# separately; this flag does not seed any data itself. See
# docs/ACCESS_AND_TESTING.md "Demo Quick Access (role login)".
QUORFIX_DEMO_MODE=false

# Optional. Only consulted when QUORFIX_DEMO_MODE=true. Shortens the
# session cookie lifetime for a shared public demo (default 4 hours,
# instead of Django's own two-week default) — a throwaway exploration
# session on a shared machine/browser shouldn't linger. See
# config/settings/base.py.
QUORFIX_DEMO_SESSION_COOKIE_AGE_SECONDS=

# A second, independent flag from QUORFIX_DEMO_MODE above — enabling Quick
# Access login must never, by itself, also enable the destructive
# `manage.py reset_public_demo` command (see scripts/demo reset-demo).
# Leave unset/false for an ordinary installation, including one with
# QUORFIX_DEMO_MODE=true, unless you specifically intend to run scheduled/
# manual demo resets. See docs/DEMO_DEPLOYMENT.md "Guarded automatic demo
# reset".
QUORFIX_DEMO_RESET_ENABLED=false

# Ops-only safety marker read by scripts/demo (the demo lifecycle/deployment
# operator entry point) — never read by the Django application itself, and
# unrelated to QUORFIX_DEMO_MODE above (that one gates an application
# feature; this one identifies a deployment to a shell script). scripts/demo
# refuses to run any lifecycle command unless its resolved env file declares
# QUORFIX_ENV=demo verbatim, so an operator can't accidentally point it at
# the wrong deployment's env file. Leave unset for any installation that
# isn't the public demo (docs/DEMO_DEPLOYMENT.md) — there is nothing else
# in the application that reads or requires this variable.
QUORFIX_ENV=

# ============================================================================
# Email (invitations)
# ============================================================================

# Development and test use built-in backends (console / locmem) regardless
# of these values. REQUIRED IN PRODUCTION: production.py hardcodes the SMTP
# backend, and EMAIL_HOST must be set (console/locmem are rejected outright
# by the production checks). EMAIL_HOST_USER/EMAIL_HOST_PASSWORD are NOT
# required — some relays authenticate by source IP/allowlist rather than a
# username and password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=webmaster@localhost

# REQUIRED when QUORFIX_DEMO_MODE=true; ignored otherwise. Every
# demo-triggered email (see apps.core.mail.DemoMailSinkBackend) is
# redirected here instead of its real recipient — the public demo must
# never be usable to deliver mail to an arbitrary external address. Set
# this to a mailbox an operator actually reads, never a real customer's
# address. Validated at startup by apps.core.checks (quorfix.E013).
QUORFIX_DEMO_MAIL_SINK=

# ============================================================================
# Attachments
# ============================================================================

# REQUIRED IN PRODUCTION: must be an absolute path on a persistent, durable
# volume — not empty, not relative, and not under a temporary directory such
# as /tmp (attachments would be lost on container recreation). Defaults to
# <repo>/backend/media if unset. docker-compose.prod.yml hardcodes this to
# /data/attachments regardless of this value — that path is where the
# backend Dockerfile's `production` stage creates and chowns a directory for
# the named `attachments_data` volume to mount over; this variable only
# matters directly when running the backend outside that Compose file.
# GET /api/health/ready/ verifies at runtime that this path exists and is
# writable (see apps.core.storage_readiness); `manage.py check_attachment_storage`
# verifies the same thing once at container startup, before the real
# process starts.
ATTACHMENTS_LOCAL_ROOT=

# Optional. Only consulted when QUORFIX_DEMO_MODE=true — overrides the
# demo's tightened 2 MB attachment size cap (vs. the normal 10 MB; see
# MAX_ATTACHMENT_SIZE_BYTES in config/settings/base.py). Every other
# attachment protection (content-type allowlist, magic-byte verification,
# server-generated storage keys) is unaffected either way.
QUORFIX_DEMO_MAX_ATTACHMENT_SIZE_BYTES=

# ============================================================================
# Analytics
# ============================================================================

# Dashboard cache TTL in seconds. Must be a positive integer. In production
# it is additionally bounded to a maximum of 86400 (24 hours) by the
# production checks; development/test may use any positive value.
ANALYTICS_CACHE_TTL_SECONDS=60

# ============================================================================
# Production Compose only (docker-compose.prod.yml)
# ============================================================================
#
# Everything below is read only by docker-compose.prod.yml itself (Compose
# variable substitution) or by the backend/celery_worker processes it starts
# — docker-compose.yml (local development) ignores all of it.

# Build metadata (see "Build metadata" in backend/Dockerfile and
# frontend/Dockerfile) — plain build args, not secrets. Leave unset for a
# throwaway local build; a release process should pass the real tag/commit,
# e.g. VERSION=0.5.0 VCS_REF=$(git rev-parse --short HEAD).
VERSION=local
VCS_REF=unknown

# Gunicorn (backend web process). Defaults are sane if left unset: workers
# defaults to (2 * visible CPU count) + 1, timeout to 30 seconds — see
# backend/gunicorn.conf.py.
GUNICORN_WORKERS=
GUNICORN_TIMEOUT=

# Celery worker. concurrency defaults to 2 if unset, loglevel to "info".
# Kept conservative deliberately for a public demo — a low, fixed
# concurrency bounds how many tasks (e.g. notification emails) one abusive
# burst of activity can process in parallel. See docs/SECURITY.md "Celery
# hardening".
CELERY_WORKER_CONCURRENCY=
CELERY_WORKER_LOGLEVEL=

# Container resource ceilings (docker-compose.prod.yml) — bounds what one
# abused/misbehaving service can consume on the host. Sane defaults if left
# unset (512m/1.0 CPU for db/backend/celery_worker/frontend, 256m/0.5 CPU
# for redis; pids_limit 200/200/100/100/50 respectively) — override only if
# your host's actual resources need something different. See
# docs/DEMO_DEPLOYMENT.md "Container resource limits".
QUORFIX_DB_MEM_LIMIT=
QUORFIX_DB_CPUS=
QUORFIX_DB_PIDS_LIMIT=
QUORFIX_REDIS_MEM_LIMIT=
QUORFIX_REDIS_CPUS=
QUORFIX_REDIS_PIDS_LIMIT=
QUORFIX_BACKEND_MEM_LIMIT=
QUORFIX_BACKEND_CPUS=
QUORFIX_BACKEND_PIDS_LIMIT=
QUORFIX_CELERY_MEM_LIMIT=
QUORFIX_CELERY_CPUS=
QUORFIX_CELERY_PIDS_LIMIT=
QUORFIX_FRONTEND_MEM_LIMIT=
QUORFIX_FRONTEND_CPUS=
QUORFIX_FRONTEND_PIDS_LIMIT=

# Bounded JSON-file log rotation, shared by every service (docker-compose.
# prod.yml's x-logging anchor) — without this, Docker's default logging
# driver keeps every container's stdout/stderr forever, an unbounded disk
# vector on its own. Defaults: 10m per file, 3 files kept.
QUORFIX_LOG_MAX_SIZE=
QUORFIX_LOG_MAX_FILES=
