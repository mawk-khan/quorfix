# Copy to .env and fill in real values. Never commit .env.
#
# Values below marked "REQUIRED IN PRODUCTION" are validated at startup by
# apps.core.checks (see backend/apps/core/checks.py) whenever
# ENVIRONMENT=production — `manage.py check` and `manage.py migrate` both
# fail fast, before touching the database, if any are missing or unsafe.
# Development and test never require these — see ENVIRONMENT below.

# ============================================================================
# Shared
# ============================================================================

# development | test | production — explicit, not inferred from DEBUG or the
# settings module filename. Each config/settings/*.py module already sets
# its own literal value (development.py -> "development", test.py -> "test",
# production.py -> "production"); this only matters if you introduce a new
# settings module and forget to set it there — the safe fallback is
# "development", never "production".
ENVIRONMENT=development

# Which settings module to boot. Local/dev containers normally use
# config.settings.development; CI uses config.settings.test; production
# deployments must use config.settings.production.
DJANGO_SETTINGS_MODULE=config.settings.development
# DJANGO_SETTINGS_MODULE=config.settings.production   # production example

# REQUIRED IN PRODUCTION. A unique, unpredictable value — not the placeholder
# below, not short, not committed anywhere. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret

# Must be "false" in production (production.py hardcodes DEBUG=False
# regardless of this value, but keep it false here too — DEBUG=True leaks
# stack traces, settings, and environment details on error pages).
DJANGO_DEBUG=true

# REQUIRED IN PRODUCTION. Comma-separated exact hostnames this instance is
# served from, e.g. "app.example.com". A bare wildcard ("*") is rejected by
# the production checks — Django's Host-header validation exists precisely
# to prevent host-header-based attacks, and a wildcard defeats it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ============================================================================
# Database (PostgreSQL)
# ============================================================================

# REQUIRED IN PRODUCTION: NAME and HOST must be non-empty, and the stack only
# supports PostgreSQL (SQLite is rejected by the production checks).
POSTGRES_DB=bugfixer
POSTGRES_USER=bugfixer
POSTGRES_PASSWORD=bugfixer
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================================================
# Redis / Celery
# ============================================================================

# REQUIRED IN PRODUCTION. Backs the shared cache (throttle counters, the
# analytics dashboard cache) and the Celery broker — must be a real
# redis:// or rediss:// URL, not a placeholder or unreachable host. The
# production checks validate the URL scheme only; they never attempt a
# network connection (that belongs to the readiness endpoint, not a
# system check).
REDIS_URL=redis://redis:6379/0

# ============================================================================
# CORS / CSRF (frontend origins)
# ============================================================================

# Same-origin note: the default architecture serves the Next.js frontend and
# proxies /api/* through it to the backend (see frontend/next.config.ts), so
# the browser only ever talks to one origin. In that shape,
# CORS_ALLOWED_ORIGINS should be left EMPTY in production — the production
# checks accept that as valid and do not require it to be non-empty. Only
# set it if something other than the bundled frontend needs direct
# cross-origin browser access to the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# REQUIRED IN PRODUCTION. Comma-separated origins the browser will POST/PUT/
# PATCH/DELETE from — must include an explicit http:// or https:// scheme
# (HTTPS is strongly recommended in production). A bare wildcard ("*") is
# rejected; a scoped subdomain wildcard like "https://*.example.com" is
# accepted, matching what Django itself supports.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ============================================================================
# Cookies / security
# ============================================================================
#
# No environment variables here — session/CSRF cookie flags (Secure,
# HttpOnly, SameSite) and the HTTPS-redirect/HSTS settings are hardcoded per
# settings module (see backend/config/settings/base.py and production.py),
# not read from the environment, so they can never be silently weakened by a
# stray .env value. Production hardcodes SESSION_COOKIE_SECURE=True,
# CSRF_COOKIE_SECURE=True, SESSION_COOKIE_HTTPONLY=True,
# SESSION_COOKIE_SAMESITE="Lax" (chosen so an already-signed-in user
# following an emailed invitation link — a cross-site top-level navigation —
# still carries their session cookie; "Strict" would block that),
# SECURE_SSL_REDIRECT=True, and SECURE_PROXY_SSL_HEADER assuming TLS
# terminates at an upstream reverse proxy that forwards
# X-Forwarded-Proto. All of this is verified at startup by the production
# checks (bugfixer.E007, bugfixer.E008).

# ============================================================================
# Frontend
# ============================================================================

BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_BASE_URL=http://localhost:3000

# ============================================================================
# Email (invitations)
# ============================================================================

# Development and test use built-in backends (console / locmem) regardless
# of these values. REQUIRED IN PRODUCTION: production.py hardcodes the SMTP
# backend, and EMAIL_HOST must be set (console/locmem are rejected outright
# by the production checks). EMAIL_HOST_USER/EMAIL_HOST_PASSWORD are NOT
# required — some relays authenticate by source IP/allowlist rather than a
# username and password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=webmaster@localhost

# ============================================================================
# Attachments
# ============================================================================

# REQUIRED IN PRODUCTION: must be an absolute path on a persistent, durable
# volume — not empty, not relative, and not under a temporary directory such
# as /tmp (attachments would be lost on container recreation). Defaults to
# <repo>/backend/media if unset.
ATTACHMENTS_LOCAL_ROOT=

# ============================================================================
# Analytics
# ============================================================================

# Dashboard cache TTL in seconds. Must be a positive integer. In production
# it is additionally bounded to a maximum of 86400 (24 hours) by the
# production checks; development/test may use any positive value.
ANALYTICS_CACHE_TTL_SECONDS=60
