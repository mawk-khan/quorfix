# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Postgres ---
POSTGRES_DB=bugfixer
POSTGRES_USER=bugfixer
POSTGRES_PASSWORD=bugfixer
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- CORS / CSRF (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Frontend ---
BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_BASE_URL=http://localhost:3000

# --- Email (invitations; production only, dev/test use built-in backends) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=webmaster@localhost
